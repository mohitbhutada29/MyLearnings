
    <!--Registers/Maps the views with viewmodels-->
    <ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:MvvmDemoProject.ViewModels"
    xmlns:views="clr-namespace:MvvmDemoProject.Views">
    <DataTemplate DataType="{x:Type vms:ViewAViewModel}">
        <views:ViewA />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ViewBViewModel}">
        <views:ViewB />
    </DataTemplate>
</ResourceDictionary>